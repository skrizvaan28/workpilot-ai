# WorkPilot AI - Backend Environment Configuration

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Server CORS (allowed frontend origins, comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Planned Step 2: Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://workpilot:workpilot@localhost:5432/workpilot

# Planned Step 3: JWT Security Configuration
SECRET_KEY=replace-this-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM (backend only — never put this key in the frontend)
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding provider configuration
# Local fallback is the default when no API key is configured.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-fallback-v1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSION=128

# Vector storage backend.
# Use "json" for the current local fallback implementation, or "pgvector" when a PostgreSQL + pgvector environment is available.
VECTOR_STORE=json
VECTOR_DIMENSION=128
VECTOR_SIMILARITY_METRIC=cosine
VECTOR_TOP_K=5
VECTOR_MIN_SIMILARITY=0.2
